---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import { site } from '../site';

const portraitFile = ['portrait.jpg', 'portrait.jpeg', 'portrait.png', 'portrait.webp'].find((name) =>
  existsSync(new URL(`../../public/${name}`, import.meta.url)),
);
---

<Base
  title="About"
  description="Quddusia Azam grew up in Doranda and taught English at Jawahar Vidya Mandir, Shyamali, Ranchi. She writes and paints."
>
  <h1 class="page-title">About</h1>
  <hr class="rule" />
  <section class="block with-portrait">
    <figure class="portrait">
      <div class="portrait-mat">
        {
          portraitFile ? (
            <img src={`/${portraitFile}`} alt="Quddusia Azam" />
          ) : (
            <div class="portrait-frame" aria-hidden="true">
              <span>QA</span>
            </div>
          )
        }
      </div>
      {!portraitFile && <figcaption>A photograph will be placed here.</figcaption>}
    </figure>
    <div>
      <p>
        Quddusia Azam lives in Ranchi, Jharkhand. She grew up in the family house at Bazaar Mohallah, Doranda. Her
        grandfather, Md. Yaqub, had the children sent to a convent school.
      </p>
      <p>
        She taught English at <a href={site.schoolUrl} rel="noopener noreferrer">{site.school}</a>, from 1992 for three
        decades. The first children were a prep class. Most of the years were classes 3, 4, and 5, and she taught up to
        class 10. She holds a B.Ed. and an M.A. She has recently retired from school. She has written about the classroom
        in <a href="/writing/the-last-two-days">The last two days</a>, and about the house in <a href="/writing/bazaar-mohallah">Bazaar Mohallah</a>.
      </p>
      <p>
        She writes in English, and she paints. From Ranchi she travels through India, and to Canada and the United
        Kingdom, to visit family.
      </p>
      <p>Azam Mam is the name on the door: her surname, and Mam, as her students address a teacher. This site is her desk.</p>
    </div>
  </section>
  <section class="block">
    <h2>Write to her</h2>
    <p>
      Write to her at <a href={`mailto:${site.email}`}>{site.email}</a>, or find her on <a href={site.facebook}>Facebook</a>.
    </p>
  </section>
</Base>
