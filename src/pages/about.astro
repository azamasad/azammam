---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---

<Base
  title="About"
  description="Quddusia Azam lives in Ranchi. She teaches, writes, and paints, and travels in India, Canada, and the United Kingdom."
>
  <h1 class="page-title">About</h1>
  <hr class="rule" />
  <section class="block">
    <p>
      Quddusia Azam lives in Ranchi, Jharkhand. From there she travels through India, and to Canada and the United
      Kingdom to visit family.
    </p>
    <p>
      She is a teacher, a writer, and a painter. This site is her desk. Essays and opinions go in Writing. Paintings are
      hung in the gallery. The teaching page is a plain record of thirty years in the classroom.
    </p>
    <p>Azam Mam is the name on the door: her surname, and Mam, as a teacher is addressed.</p>
  </section>
  <section class="block">
    <h2>Write to her</h2>
    <p>
      Write to her at <a href={`mailto:${site.email}`}>{site.email}</a>, or find her on
      <a href={site.facebook}>Facebook</a>. The writing on this site is in English.
    </p>
  </section>
</Base>
